{
  "name": "yaoqiu-yueduo",
  "version": "1.0.0",
  "private": true,
  "description": "要求越多：用网页 3D 逐帧渲染、用数据讲故事的 16:9 动效短片",
  "type": "module",
  "scripts": {
    "render": "node render.mjs",
    "still": "node render.mjs --still 21.6",
    "preview": "npx serve .",
    "beni:render": "node render.mjs --page beni/index.html --fps 60 --blur 8",
    "beni:still": "node render.mjs --page beni/index.html --still 3",
    "beni:single": "python3 beni/tools/build_single.py",
    "beni:imaging:render": "node render.mjs --page beni/imaging.html --out out/beni-imaging.mp4 --fps 60 --blur 8",
    "beni:imaging:single": "python3 beni/tools/build_single.py imaging"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  },
  "dependencies": {
    "three": "0.160.0"
  }
}
